!version 0.5

# =============== Common ===============
[help] Build the CLI and GUI
[pass] Build complete.
[fail] Build failed.
build():
    zig build

[help] Build the CLI and GUI in release mode
[pass] Release build complete.
[fail] Release build failed.
build-release():
    zig build -Doptimize=fast -Dstrip=true

[help] Package the CLI and GUI
[desc] Build release and package both the CLI and the GUI for this platform.
[pass] Packaged the CLI and GUI.
[fail] Packaging failed.
package() & cli.package & gui.package

[help] Format all Zig files
[pass] Formatting complete.
fmt():
    zig fmt src build.zig build.zig.zon cli.zon

[help] Clean cache and build output
[pass] Clean complete.
[fail] Clean failed.
clean():
    rm -rf .zig-cache zig-out zig-pkg

# =============== CLI ===============
[help] CLI development tasks
group cli {

    [help] Build the CLI
    [pass] CLI build complete.
    [fail] CLI build failed.
    build():
        zig build cli

    [help] Run the CLI with arguments
    [fail] CLI run failed.
    run(args..):
        zig build run-cli -- {{args}}

    [help] Build the CLI in release mode
    [pass] CLI release build complete.
    [fail] CLI release build failed.
    build-release():
        zig build cli -Doptimize=fast -Dstrip=true

    [help] Run the CLI in release mode with arguments
    [fail] CLI release run failed.
    run-release(args..):
        zig build run-cli -Doptimize=fast -Dstrip=true -- {{args}}

    [help] Package the CLI as a macOS tarball
    [desc] Build release and package kocr into zig-out/bundle/macos.
    [pass] Packaged the macOS CLI.
    [fail] Packaging failed.
    package() ? @os("macos") & build-release:
        | arch="$(uname -m)"
        | bash packaging/macos/package-cli.sh "$arch"
        | ls -lh zig-out/bundle/macos/*.tar.gz zig-out/bundle/macos/*.sha256

    [help] Package the CLI as a Linux tarball
    [desc] Build release and package kocr into zig-out/bundle/linux.
    [pass] Packaged the Linux CLI.
    [fail] Packaging failed.
    package() ? @os("linux") & build-release:
        | arch="$(uname -m)"
        | bash packaging/linux/package-cli.sh "$arch"
        | ls -lh zig-out/bundle/linux/*.tar.gz zig-out/bundle/linux/*.sha256

    [help] Package the CLI as a Windows zip
    [desc] Build release and package kocr.exe into zig-out/bundle/windows.
    [pass] Packaged the Windows CLI.
    [fail] Packaging failed.
    package()
        ? @os("windows")
        & build-release
        shell~=pwsh
    :
        | ./packaging/windows/package-cli.ps1
        | Get-ChildItem zig-out/bundle/windows
}

# =============== GUI ===============
[help] GUI development tasks
group gui {

    [help] Build the GUI
    [pass] GUI build complete.
    [fail] GUI build failed.
    build():
        zig build gui

    [help] Run the GUI
    [fail] GUI run failed.
    run():
        zig build run-gui

    [help] Build the GUI in release mode
    [pass] GUI release build complete.
    [fail] GUI release build failed.
    build-release():
        zig build gui -Doptimize=fast -Dstrip=true

    [help] Run the GUI in release mode
    [fail] GUI release run failed.
    run-release():
        zig build run-gui -Doptimize=fast -Dstrip=true

    [help] Package the GUI as a macOS app
    [desc] Build release and package kocr.app into zig-out/bundle/macos.
    [pass] Packaged the macOS app.
    [fail] Packaging failed.
    package() ? @os("macos") & build-release:
        | arch="$(uname -m)"
        | bash packaging/macos/package.sh "$arch"
        | ls -lh zig-out/bundle/macos/*.dmg

    [help] Package the GUI as a Linux tarball
    [desc] Build release and package the kocr-gui tarball into zig-out/bundle/linux.
    [pass] Packaged the Linux bundle.
    [fail] Packaging failed.
    package() ? @os("linux") & build-release:
        | arch="$(uname -m)"
        | bash packaging/linux/package.sh "$arch"
        | ls -lh zig-out/bundle/linux/*.tar.gz zig-out/bundle/linux/*.sha256

    [help] Package the GUI as a Windows installer
    [desc] Build release and run the Inno Setup packaging.
    [pass] Packaged the Windows installer.
    [fail] Packaging failed.
    package()
        ? @os("windows")
        & build-release
        shell~=pwsh
    :
        | ./packaging/windows/package.ps1
        | Get-ChildItem zig-out/bundle/windows
}

# =============== Version ===============
[help] Versioning tasks
group version {

    [help] Show current version
    [fail] Could not display version.
    show() ? @has("python3"):
        python3 scripts/version.py show

    [help] Update version, commit, tag and push
    [desc] Needs a clean tree; pushing the vX.Y.Z tag starts the release workflow.
    [pass] Publish complete.
    [fail] Publish failed.
    publish(version) ? @has("python3") shell~=bash:
        test -z "$(git status --porcelain)"
        python3 scripts/version.py change {{version}}
        zig build -Doptimize=fast -Dstrip=true
        git add build.zig.zon cli.zon
        git commit -m "update to {{version}}"
        git tag {{version}}
        git push --atomic origin HEAD {{version}}
}
