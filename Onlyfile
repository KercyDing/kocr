!version 0.5

# =============== CLI ===============
[help] CLI development tasks
group cli {

    [help] Build the CLI
    [pass] CLI build complete.
    [fail] CLI build failed.
    build():
        zig build

    [help] Run the CLI with arguments
    [fail] CLI run failed.
    run(args..):
        zig build run -- {{args}}

    [help] Build the CLI in release mode
    [pass] CLI release build complete.
    [fail] CLI release build failed.
    build-release():
        zig build -Doptimize=fast -Dstrip=true

    [help] Run the CLI in release mode with arguments
    [fail] CLI release run failed.
    run-release(args..):
        zig build run -Doptimize=fast -Dstrip=true -- {{args}}

    [help] Install kocr
    [desc] Build release and install kocr.
    [pass] Installed kocr.
    [fail] Installation failed.
    install()
        ? @os("windows")
        & build-release
        shell~=pwsh
    :
        | $installDir = Join-Path $env:LOCALAPPDATA "Programs\Kocr"
        | $installPath = Join-Path $installDir "kocr.exe"
        | $stagedPath = Join-Path $env:TEMP "kocr-install-staged.exe"
        | $parentPid = (Get-CimInstance Win32_Process -Filter "ProcessId=$PID").ParentProcessId
        | $shellPath = (Get-Process -Id $PID).Path
        |
        | $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
        | $entries = @($userPath -split ';' | Where-Object { $_ })
        | $pathAdded = $false
        | if (-not ($entries | Where-Object { $_.TrimEnd('\') -ieq $installDir })) {
        |     [Environment]::SetEnvironmentVariable("Path", (@($entries) + $installDir) -join ';', "User")
        |     $pathAdded = $true
        | }
        |
        | New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        | Copy-Item zig-out\bin\kocr.exe -Destination $stagedPath -Force
        | $script = "Wait-Process -Id $parentPid; Copy-Item -LiteralPath '$stagedPath' -Destination '$installPath' -Force; Remove-Item -LiteralPath '$stagedPath' -Force"
        | $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script))
        | Start-Process -WindowStyle Hidden -FilePath $shellPath -ArgumentList "-NoProfile", "-EncodedCommand", $encoded
        | $size = (Get-Item $stagedPath).Length / 1MB
        | Write-Output ("installed kocr ({0:N2} MB)" -f $size)
        | if ($pathAdded) { Write-Output "added $installDir to PATH; restart your shell" }

    [desc] Install to ~/.local/bin/kocr.
    install() & build-release:
        | install_dir="$HOME/.local/bin"
        | staged_path="$install_dir/.kocr-install"
        | mkdir -p "$install_dir"
        | cp zig-out/bin/kocr "$staged_path"
        | chmod +x "$staged_path"
        | mv "$staged_path" "$install_dir/kocr"
        | du -sh "$install_dir/kocr"

    [help] Uninstall kocr
    [desc] Remove the installed kocr binary.
    [pass] Uninstalled kocr.
    [fail] Uninstallation failed.
    uninstall() ? @os("windows") shell~=pwsh:
        | $installDir = Join-Path $env:LOCALAPPDATA "Programs\Kocr"
        | Remove-Item (Join-Path $installDir "kocr.exe") -Force -ErrorAction SilentlyContinue
        | if (-not (Get-ChildItem -LiteralPath $installDir -Force -ErrorAction SilentlyContinue)) {
        |     Remove-Item -LiteralPath $installDir -Force -ErrorAction SilentlyContinue
        |     $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
        |     $newPath = (@($userPath -split ';' | Where-Object { $_ -and ($_.TrimEnd('\') -ine $installDir) }) -join ';')
        |     if ($newPath -ne $userPath) { [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }
        | }

    [desc] Remove ~/.local/bin/kocr.
    uninstall():
        rm -f "$HOME/.local/bin/kocr"
}

# =============== GUI ===============
[help] GUI development tasks
group gui {

    [help] Build the GUI
    [pass] GUI build complete.
    [fail] GUI build failed.
    build():
        zig build gui

    [help] Run the GUI
    [fail] GUI run failed.
    run():
        zig build run-gui

    [help] Build the GUI in release mode
    [pass] GUI release build complete.
    [fail] GUI release build failed.
    build-release():
        zig build gui -Doptimize=fast -Dstrip=true

    [help] Run the GUI in release mode
    [fail] GUI release run failed.
    run-release():
        zig build run-gui -Doptimize=fast -Dstrip=true

    [help] Package the GUI as a macOS app
    [desc] Build release and package kocr.app into zig-out/bundle.
    [pass] Packaged the macOS app.
    [fail] Packaging failed.
    package() ? @os("macos") & build-release:
        | arch="$(uname -m)"
        | bash packaging/macos/package.sh "$arch" zig-out/bundle
        | ls -lh zig-out/bundle/*.zip

    [help] Install kocr-gui
    [desc] Build release and install kocr-gui.
    [pass] Installed kocr-gui.
    [fail] Installation failed.
    install()
        ? @os("windows")
        & build-release
        shell~=pwsh
    :
        | $installDir = Join-Path $env:LOCALAPPDATA "Programs\Kocr"
        | $installPath = Join-Path $installDir "kocr-gui.exe"
        | $stagedPath = Join-Path $env:TEMP "kocr-gui-install-staged.exe"
        | $parentPid = (Get-CimInstance Win32_Process -Filter "ProcessId=$PID").ParentProcessId
        | $shellPath = (Get-Process -Id $PID).Path
        |
        | $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
        | $entries = @($userPath -split ';' | Where-Object { $_ })
        | $pathAdded = $false
        | if (-not ($entries | Where-Object { $_.TrimEnd('\') -ieq $installDir })) {
        |     [Environment]::SetEnvironmentVariable("Path", (@($entries) + $installDir) -join ';', "User")
        |     $pathAdded = $true
        | }
        |
        | New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        | Copy-Item zig-out\bin\kocr-gui.exe -Destination $stagedPath -Force
        | $script = "Wait-Process -Id $parentPid; Copy-Item -LiteralPath '$stagedPath' -Destination '$installPath' -Force; Remove-Item -LiteralPath '$stagedPath' -Force"
        | $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script))
        | Start-Process -WindowStyle Hidden -FilePath $shellPath -ArgumentList "-NoProfile", "-EncodedCommand", $encoded
        | $size = (Get-Item $stagedPath).Length / 1MB
        | Write-Output ("installed kocr-gui ({0:N2} MB)" -f $size)
        | if ($pathAdded) { Write-Output "added $installDir to PATH; restart your shell" }

    [desc] Install to ~/.local/bin/kocr-gui.
    install() & build-release:
        | install_dir="$HOME/.local/bin"
        | staged_path="$install_dir/.kocr-gui-install"
        | mkdir -p "$install_dir"
        | cp zig-out/bin/kocr-gui "$staged_path"
        | chmod +x "$staged_path"
        | mv "$staged_path" "$install_dir/kocr-gui"
        | du -sh "$install_dir/kocr-gui"
        | if [ "$(uname -s)" = "Linux" ]; then
        |     data_dir="$HOME/.local/share"
        |     install -Dm644 packaging/linux/kocr-gui.desktop "$data_dir/applications/kocr-gui.desktop"
        |     install -Dm644 src/gui/icons/linux/16.png "$data_dir/icons/hicolor/16x16/apps/kocr.png"
        |     install -Dm644 src/gui/icons/linux/32.png "$data_dir/icons/hicolor/32x32/apps/kocr.png"
        |     install -Dm644 src/gui/icons/linux/128.png "$data_dir/icons/hicolor/128x128/apps/kocr.png"
        |     install -Dm644 src/gui/icons/linux/256.png "$data_dir/icons/hicolor/256x256/apps/kocr.png"
        |     install -Dm644 src/gui/icons/linux/512.png "$data_dir/icons/hicolor/512x512/apps/kocr.png"
        |     update-desktop-database "$data_dir/applications" >/dev/null 2>&1 || true
        | fi

    [help] Uninstall kocr-gui
    [desc] Remove the installed kocr-gui binary.
    [pass] Uninstalled kocr-gui.
    [fail] Uninstallation failed.
    uninstall() ? @os("windows") shell~=pwsh:
        | $installDir = Join-Path $env:LOCALAPPDATA "Programs\Kocr"
        | Remove-Item (Join-Path $installDir "kocr-gui.exe") -Force -ErrorAction SilentlyContinue
        | if (-not (Get-ChildItem -LiteralPath $installDir -Force -ErrorAction SilentlyContinue)) {
        |     Remove-Item -LiteralPath $installDir -Force -ErrorAction SilentlyContinue
        |     $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
        |     $newPath = (@($userPath -split ';' | Where-Object { $_ -and ($_.TrimEnd('\') -ine $installDir) }) -join ';')
        |     if ($newPath -ne $userPath) { [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }
        | }

    [desc] Remove ~/.local/bin/kocr-gui.
    uninstall():
        rm -f "$HOME/.local/bin/kocr-gui"
}

# =============== Common ===============
[help] Format all Zig files
[pass] Formatting complete.
fmt():
    zig fmt src build.zig build.zig.zon cli.zon

[help] Clean cache and build output
[pass] Clean complete.
[fail] Clean failed.
clean():
    rm -rf .zig-cache zig-out zig-pkg
