.{
    .name = "kocr",
    .version = "0.5.9",
    .help = "Offline OCR for images",
    .commands = .{
        .{
            .name = "image",
            .help = "Recognize text from an image",
            .args = .{
                .{
                    .positional = .{
                        .name = "path",
                        .help = "Input image path",
                        .required = true,
                    },
                },
                .{
                    .option = .{
                        .name = "profile",
                        .help = "Model profile: tiny, small or medium",
                    },
                },
                .{
                    .option = .{
                        .name = "model_dir",
                        .help = "Model directory",
                    },
                },
                .{
                    .option = .{
                        .name = "rec_param",
                        .help = "Recognition param file",
                    },
                },
                .{
                    .option = .{
                        .name = "rec_bin",
                        .help = "Recognition bin file",
                    },
                },
                .{
                    .option = .{
                        .name = "keys",
                        .help = "Dictionary file",
                    },
                },
                .{
                    .option = .{
                        .name = "threads",
                        .help = "Inference threads, or auto",
                        .default = "auto",
                    },
                },
                .{
                    .flag = .{
                        .name = "detect",
                        .help = "Print detected text boxes",
                    },
                },
                .{
                    .flag = .{
                        .name = "line",
                        .help = "Recognize a single text line",
                    },
                },
            },
        },
        .{
            .name = "list",
            .help = "List installed model packages",
            .args = .{},
        },
        .{
            .name = "use",
            .help = "Select an installed model profile",
            .args = .{
                .{
                    .positional = .{
                        .name = "profile",
                        .help = "Model profile: tiny, small or medium",
                        .required = true,
                    },
                },
            },
        },
        .{
            .name = "install",
            .help = "Download and install a model package",
            .args = .{
                .{
                    .positional = .{
                        .name = "profile",
                        .help = "Model profile: tiny, small or medium",
                        .required = true,
                    },
                },
                .{
                    .flag = .{
                        .name = "force",
                        .help = "Replace an existing installed model",
                    },
                },
            },
        },
        .{
            .name = "uninstall",
            .help = "Remove an installed model package",
            .args = .{
                .{
                    .positional = .{
                        .name = "profile",
                        .help = "Model profile: tiny, small or medium",
                        .required = true,
                    },
                },
            },
        },
    },
}
